<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.configcat</groupId>
  <artifactId>configcat-openfeature-provider-js</artifactId>
  <version>0.3.0-wasmjs1</version>
  <packaging>klib</packaging>
  <name>ConfigCat OpenFeature Provider for Kotlin</name>
  <description>OpenFeature Provider that allows ConfigCat to be used with the OpenFeature Kotlin SDK.</description>
  <url>https://github.com/configcat/openfeature-kotlin</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://raw.githubusercontent.com/configcat/openfeature-kotlin/main/LICENSE</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>configcat</id>
      <name>ConfigCat</name>
      <email>developer@configcat.com</email>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/configcat/openfeature-kotlin</url>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/configcat/openfeature-kotlin/issues</url>
  </issueManagement>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-dom-api-compat</artifactId>
      <version>2.4.20</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.configcat</groupId>
      <artifactId>configcat-kotlin-client-js</artifactId>
      <version>5.1.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>dev.openfeature</groupId>
      <artifactId>kotlin-sdk-js</artifactId>
      <version>0.9.0-wasmjs1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib-js</artifactId>
      <version>2.4.20</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core-js</artifactId>
      <version>1.10.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-serialization-json-js</artifactId>
      <version>1.9.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
